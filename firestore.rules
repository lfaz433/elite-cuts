rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Legacy tenant access is accepted only from server-issued custom claims.
    // Client-writable profile data is never an authority source.
    function isMemberOfTenant(tId) {
      return request.auth != null && request.auth.token.tenantId == tId;
    }

    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.superadmin == true ||
        request.auth.token.platformAdmin == true
      );
    }

    function isOwnSafeProfile(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'name',
          'displayName',
          'phone',
          'photoURL',
          'locale',
          'notificationPreferences',
          'createdAt',
          'updatedAt'
        ])
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt == request.time);
    }

    function isOwnSafeProfileUpdate(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email',
          'name',
          'displayName',
          'phone',
          'photoURL',
          'locale',
          'notificationPreferences',
          'updatedAt'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
          || request.resource.data.updatedAt == request.time);
    }

    // 1. Tenants Collection (Public reads for domain resolution, admin write controls)
    match /tenants/{tenantId} {
      allow read: if true;
      // Allow create if: superadmin, already a member, OR the authenticated user is the owner
      // (the ownerUid check handles brand-new signups before server provisioning completes)
      allow create: if isSuperAdmin() 
        || isMemberOfTenant(tenantId)
        || (request.auth != null && request.resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isSuperAdmin() || isMemberOfTenant(tenantId);
    }

    // 1.1 Per-tenant business info subcollection
    match /tenants/{tenantId}/businessInfo/{docId} {
      allow read: if true; // Public: needed for landing page branding
      allow write: if isSuperAdmin() || isMemberOfTenant(tenantId);
    }

    // 1.5 Subdomains Reservation Collection
    match /subdomains/{subdomainName} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isSuperAdmin() || (request.auth != null && resource.data.ownerUid == request.auth.uid);
    }

    // 2. Scoped Business Operations Collections
    match /bookings/{bookingId} {
      allow read: if isSuperAdmin() || isMemberOfTenant(resource.data.tenantId);
      allow create: if true; // guests can create bookings
      allow update, delete: if isSuperAdmin() || isMemberOfTenant(resource.data.tenantId);
    }

    match /barbers/{barberId} {
      allow read: if true;
      allow create: if isSuperAdmin() || isMemberOfTenant(request.resource.data.tenantId);
      allow update: if isSuperAdmin() || (isMemberOfTenant(resource.data.tenantId) && isMemberOfTenant(request.resource.data.tenantId));
      allow delete: if isSuperAdmin() || isMemberOfTenant(resource.data.tenantId);
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create: if isSuperAdmin() || isMemberOfTenant(request.resource.data.tenantId);
      allow update: if isSuperAdmin() || (isMemberOfTenant(resource.data.tenantId) && isMemberOfTenant(request.resource.data.tenantId));
      allow delete: if isSuperAdmin() || isMemberOfTenant(resource.data.tenantId);
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isSuperAdmin() || isMemberOfTenant(request.resource.data.tenantId);
      allow update: if isSuperAdmin() || (isMemberOfTenant(resource.data.tenantId) && isMemberOfTenant(request.resource.data.tenantId));
      allow delete: if isSuperAdmin() || isMemberOfTenant(resource.data.tenantId);
    }

    match /gallery/{galleryId} {
      allow read: if true;
      allow create: if isSuperAdmin() || isMemberOfTenant(request.resource.data.tenantId);
      allow update: if isSuperAdmin() || (isMemberOfTenant(resource.data.tenantId) && isMemberOfTenant(request.resource.data.tenantId));
      allow delete: if isSuperAdmin() || isMemberOfTenant(resource.data.tenantId);
    }

    match /sales/{saleId} {
      allow read, update, delete: if isSuperAdmin() || isMemberOfTenant(resource.data.tenantId);
      allow create: if isSuperAdmin() || isMemberOfTenant(request.resource.data.tenantId);
    }

    match /expenses/{expenseId} {
      allow read, update, delete: if isSuperAdmin() || isMemberOfTenant(resource.data.tenantId);
      allow create: if isSuperAdmin() || isMemberOfTenant(request.resource.data.tenantId);
    }

    match /deposits/{depositId} {
      allow read, update, delete: if isSuperAdmin() || isMemberOfTenant(resource.data.tenantId);
      allow create: if isSuperAdmin() || isMemberOfTenant(request.resource.data.tenantId);
    }

    match /campaigns/{campaignId} {
      allow read, update, delete: if isSuperAdmin() || isMemberOfTenant(resource.data.tenantId);
      allow create: if isSuperAdmin() || isMemberOfTenant(request.resource.data.tenantId);
    }

    // 3. User profiles contain identity/preferences only, never authority.
    match /users/{userId} {
      allow read: if isSuperAdmin() || (request.auth != null && request.auth.uid == userId);
      allow create: if isOwnSafeProfile(userId);
      allow update: if isOwnSafeProfileUpdate(userId);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Membership authority is written only by trusted server code. A user may
    // read their own records so the client can construct its workspace session.
    match /memberships/{membershipId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // 3.4 Client Notes Collection (Tenant-scoped)
    match /client_notes/{noteId} {
      allow read, update, delete: if isSuperAdmin() || isMemberOfTenant(resource.data.tenantId);
      allow create: if isSuperAdmin() || isMemberOfTenant(request.resource.data.tenantId);
    }

    // 3.5 Audit Logs Collection (Admins can create audit logs, superadmins can manage)
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin() || (request.auth != null && request.auth.token.role == "admin");
      allow update, delete: if isSuperAdmin();
    }

    // 4. Notifications Collection
    match /notifications/{notificationId} {
      allow read, update, delete: if isSuperAdmin() || isMemberOfTenant(resource.data.tenantId) || 
                                    (request.auth != null && request.auth.uid == resource.data.recipientId);
      allow create: if isSuperAdmin() || isMemberOfTenant(request.resource.data.tenantId) || 
                                    (request.auth != null && request.auth.uid == request.resource.data.recipientId);
    }

    // 5. Payroll Collections
    match /payroll_requests/{requestId} {
      allow read, update, delete: if isSuperAdmin() || isMemberOfTenant(resource.data.tenantId);
      allow create: if isSuperAdmin() || isMemberOfTenant(request.resource.data.tenantId);
    }

    match /payroll_payments/{paymentId} {
      allow read, update, delete: if isSuperAdmin() || isMemberOfTenant(resource.data.tenantId);
      allow create: if isSuperAdmin() || isMemberOfTenant(request.resource.data.tenantId);
    }

    match /manual_payments/{paymentId} {
      allow read, write: if isSuperAdmin();
    }

    // 6. Attendance (tenant-scoped)
    match /attendance/{document=**} {
      allow read: if isSuperAdmin() || isMemberOfTenant(resource.data.tenantId);
      allow create: if isSuperAdmin() || isMemberOfTenant(request.resource.data.tenantId);
      allow update, delete: if isSuperAdmin() || isMemberOfTenant(resource.data.tenantId);
    }

    // 7. Settlements (tenant-scoped)
    match /settlements/{document=**} {
      allow read: if isSuperAdmin() || isMemberOfTenant(resource.data.tenantId);
      allow create: if isSuperAdmin() || isMemberOfTenant(request.resource.data.tenantId);
      allow update, delete: if isSuperAdmin() || isMemberOfTenant(resource.data.tenantId);
    }

    match /business/{document=**} {
      allow read, write: if false;
    }
  }
}
